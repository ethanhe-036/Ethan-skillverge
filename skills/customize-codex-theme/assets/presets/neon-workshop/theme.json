{
  "id": "neon-workshop",
  "metadata": {
    "name": "Neon Workshop",
    "summary": "深色工程工作台，以青绿与紫色光标强调操作状态。",
    "description": "深色工程工作台，以青绿与紫色光标强调操作状态。",
    "style": "dark-workshop",
    "license": "MIT",
    "provenance": "Original CSS-only preset; no third-party imagery."
  },
  "aestheticProfile": {
    "designThesis": "A dark engineering bench where sparse luminous signals mark decisions without lighting the prose.",
    "moodKeywords": ["technical", "nocturnal", "energized"],
    "signatureMotif": "cyan-violet instrument signals",
    "antiGoals": ["arcade dashboard", "glowing body text", "neon on every border"],
    "paletteStrategy": "expressive",
    "motifBudget": {
      "dominantMotifs": 1,
      "secondaryMotifs": 2,
      "accentAreaPercent": 8
    }
  },
  "compositionProfile": {
    "primaryFocus": ["composer", "active-task", "selected-navigation"],
    "secondaryFocus": ["header"],
    "quietZones": ["main", "code", "terminal", "settings"],
    "viewportIntent": {
      "wide": "preserve-hierarchy",
      "split": "rebalance-focus",
      "narrow": "reduce-decoration"
    }
  },
  "materialGrammar": {
    "canvas": "graphite-bench",
    "navigation": "graphite-panel",
    "controls": "luminous-edge",
    "reading": "opaque-graphite",
    "transient": "graphite-panel",
    "elevationLevels": 3,
    "lightingDirection": "top"
  },
  "tokens": {
    "canvas": "#11141a",
    "surface": "#181d26",
    "surfaceRaised": "#212836",
    "text": "#f2f5f7",
    "muted": "#a8b0be",
    "accent": "#4fd1c5",
    "accentText": "#071412",
    "border": "#364050",
    "focus": "#7fe7df",
    "success": "#69d391",
    "warning": "#e4bd67",
    "danger": "#ff7b7b",
    "info": "#75bdf5",
    "codeSurface": "#0e1117",
    "terminalSurface": "#090c11",
    "terminalText": "#f4f7f8",
    "diffAddSurface": "#173a2b",
    "diffRemoveSurface": "#412326",
    "approvalSurface": "#3a3320",
    "radiusSmall": "5px",
    "radiusMedium": "9px",
    "radiusLarge": "14px",
    "shadowLow": "0 1px 3px rgba(0,0,0,.34)",
    "shadowHigh": "0 16px 38px rgba(0,0,0,.48)",
    "bodyFont": "Inter, ui-sans-serif, system-ui, sans-serif",
    "displayFont": "Inter, ui-sans-serif, system-ui, sans-serif"
  },
  "capabilities": {
    "mode": "dark",
    "cssOnly": true,
    "userArt": false,
    "glassChrome": false,
    "tactileControls": false,
    "experimental": false
  },
  "usability": {
    "typography": "native",
    "geometry": "native",
    "criticalSurfaces": "opaque",
    "motion": "state-only"
  }
}
