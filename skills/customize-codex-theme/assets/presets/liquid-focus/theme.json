    "diffRemoveSurface": "#f2dbde",
    "approvalSurface": "#f3e8c9",
    "radiusSmall": "8px",
    "radiusMedium": "14px",
    "radiusLarge": "20px",
    "shadowLow": "0 3px 10px rgba(30,70,92,.10)",
    "shadowHigh": "0 18px 44px rgba(30,70,92,.18)",
    "bodyFont": "Inter, ui-sans-serif, system-ui, sans-serif",
    "displayFont": "Inter, ui-sans-serif, system-ui, sans-serif"
