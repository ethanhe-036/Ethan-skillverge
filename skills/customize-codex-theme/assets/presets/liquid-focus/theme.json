{
  "id": "liquid-focus",
  "metadata": {
    "name": "Liquid Focus",
    "summary": "克制的液态玻璃；真实透明只用于小型顶栏，关键阅读面保持不透明。",
    "description": "克制的液态玻璃；顶栏使用受控模糊，菜单和输入区以不透明高光、边缘与阴影保留玻璃质感。",
    "style": "liquid-glass",
    "license": "MIT",
    "provenance": "Original CSS-only preset; no third-party imagery."
  },
  "aestheticProfile": {
    "designThesis": "An optical engineering instrument where oceanic clarity surrounds calm, opaque work surfaces.",
    "moodKeywords": ["precise", "oceanic", "focused"],
    "signatureMotif": "a restrained optical horizon line",
    "antiGoals": ["generic premium glass", "blur across reading surfaces", "decorative glow"],
    "paletteStrategy": "restrained",
    "motifBudget": {
      "dominantMotifs": 1,
      "secondaryMotifs": 2,
      "accentAreaPercent": 6
    }
  },
  "compositionProfile": {
    "primaryFocus": ["composer", "active-task", "selected-navigation"],
    "secondaryFocus": ["header"],
    "quietZones": ["main", "code", "terminal", "settings"],
    "viewportIntent": {
      "wide": "preserve-hierarchy",
      "split": "rebalance-focus",
      "narrow": "reduce-decoration"
    }
  },
  "materialGrammar": {
    "canvas": "cool-mica",
    "navigation": "cool-mica",
    "controls": "optical-glass",
    "reading": "opaque-instrument",
    "transient": "optical-glass",
    "elevationLevels": 3,
    "lightingDirection": "top-left"
  },
  "tokens": {
    "canvas": "#e8f0f5",
    "surface": "#f5f9fc",
    "surfaceRaised": "#ffffff",
    "text": "#172631",
    "muted": "#52616d",
